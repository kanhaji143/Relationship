rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES — Phase 0 draft
//
// CRITICAL DESIGN DECISION (docs/DECISIONS.md #3):
// The browser never talks to Firestore directly. Every sensitive operation is
// performed by Cloud Functions or Next.js server routes using the Admin SDK,
// which BYPASSES these rules. Therefore the safest correct posture is to deny
// all direct client access, and open specific read paths ONLY when a feature
// is live and reviewed (e.g., participant-scoped chat reads in a later phase,
// with explicit tests).
//
// Any rule opened here must have: (1) an authorization rationale in a comment,
// (2) integration tests, (3) a review by a second person before production.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default for web/mobile clients.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // FUTURE (per-phase, only when implemented + tested):
    //  - Phase 3: conversations/{matchId}/messages — allow read if
    //    request.auth.uid is in participantUids, preventing enumeration
    //    of match IDs (custom claims or secured lookup required).
    //  - Public marketing content collections could be allow read:true if created.
    // ---------------------------------------------------------------
  }
}
