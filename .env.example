# =============================================================
# ENVIRONMENT VARIABLES — copy to `.env.local` and fill values.
# NEVER commit `.env.local` or real secrets to git.
# =============================================================

# ---------- Firebase (client, public values — see Firebase console > Project settings) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin SDK (server-only, SECRET) ----------
# Best practice: use ADC (Application Default Credentials) instead of a file.
# Local dev: run `npx firebase-toolslogin` … or paste service account JSON path here (gitignored).
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# ---------- App config ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Provisional working brand — branding is configurable until trademark/domain clearance
NEXT_PUBLIC_BRAND_NAME=Bondora
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_CONTACT=

# ---------- Payments (Razorpay) — leave empty = billing disabled/test mode ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Test-mode switches (dev only) ----------
BILLING_TEST_MODE=true
